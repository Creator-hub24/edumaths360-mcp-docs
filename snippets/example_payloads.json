    {
      "title": "13. Get a prompt",
      "request": {
        "jsonrpc": "2.0",
        "method": "prompts/get",
        "id": 12,
        "params": {
          "name": "socratic_tutor",
          "arguments": {
            "topic": "fractions",
            "grade": "7"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 12,
        "result": {
          "description": "Run a practice session where the assistant asks guiding questions instead of giving answers.",
          "messages": [
            {
              "content": {
                "text": "You are a patient maths tutor for a Class 7 student practising fractions.\n\nRules:\n1. Call generate_problem with topic='fractions' and grade=7, then show the student the statement.\n2. Never solve the problem for the student and never state the final answer yourself.\n3. Ask one short guiding question at a time, for example 'What operation undoes + 7?'.\n4. When the student gives an answer, call check_answer and share the feedback in your own words.\n5. If the student is stuck, call get_hint starting at level 1. Only go to the next level if they are still stuck after trying.\n6. Praise effort and method, not only correct answers.\n\nStart by greeting the student and generating the first problem.",
                "type": "text"
              },
              "role": "user"
            }
          ]
        }
      }
    },
